      "structuralNodes": [],
      "blocks": [
        {
          "id": "f0080000-0000-4000-8000-000000000001",
          "structuralNodeId": null,
          "sequenceIndex": 0,
          "blockType": "arabic",
          "languageCode": "ar",
          "direction": "rtl",
          "textContent": "بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّحِيْمِ",
          "rawOcrText": null,
          "ttsEligible": true,
          "verificationStatus": "in_review",
          "provenanceNotes": "Authoritative master transcription: printed page 8"
        },
        {
          "id": "f0080100-0000-4000-8000-000000000001",
          "structuralNodeId": null,
          "sequenceIndex": 1,
          "blockType": "heading",
          "languageCode": "en",
          "direction": "ltr",
          "textContent": "IN THE NAME OF ALLAH, THE MOST GRACIOUS, THE MOST MERCIFUL.",
          "rawOcrText": null,
          "ttsEligible": false,
          "verificationStatus": "in_review",
          "provenanceNotes": "Authoritative master transcription: printed page 8"
        },
        {
          "id": "f0080200-0000-4000-8000-000000000001",
          "structuralNodeId": null,
          "sequenceIndex": 2,
          "blockType": "heading",
          "languageCode": "en",
          "direction": "ltr",
          "textContent": "AUTHOR’S FOREWORD",
          "rawOcrText": null,
          "ttsEligible": false,
          "verificationStatus": "in_review",
          "provenanceNotes": "Authoritative master transcription: printed page 8"
        },
        {
          "id": "f0080300-0000-4000-8000-000000000001",
          "structuralNodeId": null,
          "sequenceIndex": 3,
          "blockType": "arabic",
          "languageCode": "ar",
          "direction": "rtl",
          "textContent": "نَحْمَدُهُ وَنُصَلِّيْ وَنُسَلِّمُ عَلٰى رَسُوْلِهِ الْكَرِيْمِ وَآلِهِ وَصَحْبِهِ وَأَتْبَاعِهِ الْهُدَاةِ لِلدِّيْنِ الْقَوِيْمِ",
          "rawOcrText": null,
          "ttsEligible": true,
          "verificationStatus": "in_review",
          "provenanceNotes": "Authoritative master transcription: printed page 8"
        },
        {
          "id": "f0080400-0000-4000-8000-000000000001",
          "structuralNodeId": null,
          "sequenceIndex": 4,
          "blockType": "translation",
          "languageCode": "en",
          "direction": "ltr",
          "textContent": "“We glorify Allah and ask blessings on and salute His noble Prophet, his companions and those who follow him in upholding the cause of the right religion.”",
          "rawOcrText": null,
          "ttsEligible": true,
          "verificationStatus": "in_review",
          "provenanceNotes": "Authoritative master transcription: printed page 8"
        },
        {
          "id": "f0080500-0000-4000-8000-000000000001",
          "structuralNodeId": null,
          "sequenceIndex": 5,
          "blockType": "english",
          "languageCode": "en",
          "direction": "ltr",
          "textContent": "The indifference of Muslims towards practising Islam these days is too well known. So much so that even Salaat, which is the most important pillar of Islam (after Imaan) and the first and the foremost thing to be reckoned on the Day of Judgement, is being badly neglected. Although every call to ‘Islam’, nowadays, seems to be only a cry in the wilderness, yet experience shows that efforts in this direction are not altogether fruitless. The glorious words of the Holy Prophet (Sallallaho alaihe wasallam) are sure to benefit those with a receptive and submissive frame of mind. With this idea in view and to comply with the long-standing request of some of my dear friends, I have taken upon myself to write this booklet, which is the second of the series on ‘Tabligh’, the first one being “Virtues of Tabligh.”",
          "rawOcrText": null,
          "ttsEligible": true,
          "verificationStatus": "in_review",
          "provenanceNotes": "Authoritative master transcription: printed page 8"
        },
        {
          "id": "f0080600-0000-4000-8000-000000000001",
          "structuralNodeId": null,
          "sequenceIndex": 6,
          "blockType": "arabic",
          "languageCode": "ar",
          "direction": "rtl",
          "textContent": "وَمَا تَوْفِيْقِيْ إِلَّا بِاللّٰهِ، عَلَيْهِ تَوَكَّلْتُ وَإِلَيْهِ أُنِيْبُ",
          "rawOcrText": null,
          "ttsEligible": true,
          "verificationStatus": "in_review",
          "provenanceNotes": "Authoritative master transcription: printed page 8"
        },
        {
          "id": "f0080700-0000-4000-8000-000000000001",
          "structuralNodeId": null,
          "sequenceIndex": 7,
          "blockType": "translation",
          "languageCode": "en",
          "direction": "ltr",
          "textContent": "And my success can only come from Allah! And in Him I trust and unto Him I turn ................. (XI:88)",
          "rawOcrText": null,
          "ttsEligible": true,
          "verificationStatus": "in_review",
          "provenanceNotes": "Authoritative master transcription: printed page 8"
        }
      ]
    },
